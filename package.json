{
  "name": "kolequant-age",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "build:pages": "node scripts/build-pages.mjs",
    "build:native": "node scripts/build-pages.mjs --native",
    "build:store-worker": "node native/build-worker.mjs",
    "serve:pages": "node scripts/serve-pages.mjs",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --max-warnings 0",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "locale:build": "node scripts/build-locale.mjs",
    "locale:check": "node scripts/build-locale.mjs --check",
    "check": "npm run locale:check && npm run lint && npm run typecheck && npm test",
    "db:generate": "drizzle-kit generate",
    "postinstall": "node scripts/report-install.mjs",
    "report:install": "node scripts/report-install.mjs",
    "report:qa": "node scripts/report-qa.mjs",
    "report:assets": "node scripts/report-assets.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.7",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.4",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "jose": "6.2.18",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "react-resizable-panels": "^4.24.1",
    "recharts": "^3.11.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.1",
    "vaul": "^1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@cloudflare/workers-types": "5.20261120.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "json-rpc-2.0": "1.8.1",
    "raw-body": "4.0.0",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vinext": "1.4.6",
    "vite": "8.3.8",
    "wrangler": "4.165.0"
  },
  "type": "module",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    },
    "@typescript-eslint/typescript-estree@8.72.1": {
      "minimatch": "11.0.4"
    },
    "fflate": "0.7.5",
    "miniflare": {
      "sharp": "0.35.5"
    }
  }
}
