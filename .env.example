# Hosted: configure as a Sites secret, not in source or the hosting manifest.
# Local only: place an independently generated 32-byte base64 key in ignored .dev.vars.
ASSESSMENT_ENCRYPTION_KEY=

# Set the sender after the domain is verified in Resend.
RESEND_API_KEY=
AUTH_EMAIL_FROM=KoleQuant <support@kolequant.xyz>

# Social sign-in uses PUBLIC_SITE_ORIGIN for the HTTPS callback URLs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Keep charging off until the merchant account, price and webhook delivery are verified.
PAYMENTS_ENABLED=false
PAYMENT_WEBHOOK_READY=false
PUBLIC_SITE_ORIGIN=https://kolequant-age-prototype.quartzpaddock.chatgpt.site
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_REPORT_PRICE_ID=
STRIPE_AUTOMATIC_TAX=true

# Temporary private content review. Does not create purchased entitlements.
# Automatically inactive whenever PAYMENTS_ENABLED=true.
REPORT_REVIEW_MODE=false
