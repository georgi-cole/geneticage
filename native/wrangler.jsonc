{
  "name": "geneticage-store-beta",
  "main": "../dist-native-worker/worker.mjs",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "geneticage.kolequant.xyz", "custom_domain": true }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "geneticage-store-beta",
    "database_id": "92b54bbd-6b44-4012-b754-30c9b5d87cab",
    "migrations_dir": "../drizzle"
  }],
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": false },
  "vars": {
    "PUBLIC_SITE_ORIGIN": "https://geneticage.kolequant.xyz",
    "NATIVE_AUTH_ENABLED": "true",
    "REPORT_REVIEW_MODE": "true",
    "PAYMENTS_ENABLED": "false",
    "AUTH_EMAIL_FROM": "GeneticAge <sign-in@auth.kolequant.xyz>"
  }
}
